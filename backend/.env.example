# Database. Local default is SQLite; on AWS use RDS PostgreSQL:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/deliverylens
DATABASE_URL=sqlite:///./deliverylens.db

# Folder with the Halcyon CSVs (default: ../data/halcyon-dataset relative to backend/)
# DATA_DIR=/data

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM provider: "mock" (offline, deterministic, default) or "bedrock"
LLM_PROVIDER=mock

# Only used when LLM_PROVIDER=bedrock. Credentials come from the normal AWS chain (IAM role, profile, env).
AWS_REGION=us-east-1
# Model or inference-profile IDs enabled in your account (placeholders, replace them):
BEDROCK_MODEL_FAST=SET-ME-bedrock-model-id
BEDROCK_MODEL_SMART=SET-ME-bedrock-model-id
LLM_TIMEOUT_SECONDS=30
