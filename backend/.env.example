# Database. Local default is SQLite; on AWS use RDS PostgreSQL:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/deliverylens
DATABASE_URL=sqlite:///./deliverylens.db

# Folder with the Halcyon CSVs (default: ../data/halcyon-dataset relative to backend/)
# DATA_DIR=/data

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM provider: "mock" (offline, deterministic, default), "gemini" (local demo) or "bedrock" (AWS)
# --- Option 1: mock (no key, works offline) ---
LLM_PROVIDER=mock

# --- Option 2: Google Gemini (for local demo) ---
# Get a key at https://aistudio.google.com/apikey , put it in backend/.env (never in .env.example,
# never committed), comment out LLM_PROVIDER=mock above, then restart uvicorn.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=paste-your-key-here
# GEMINI_MODEL=gemini-2.5-flash

# --- Option 3: Amazon Bedrock (on AWS) ---
# Only used when LLM_PROVIDER=bedrock. Credentials come from the normal AWS chain (IAM role, profile, env).
AWS_REGION=us-east-1
# Model or inference-profile IDs enabled in your account (placeholders, replace them):
BEDROCK_MODEL_FAST=SET-ME-bedrock-model-id
BEDROCK_MODEL_SMART=SET-ME-bedrock-model-id
# Timeout for one model call (Bedrock and Gemini)
LLM_TIMEOUT_SECONDS=30

# Order desk: folder with the sample client emails and manifest.json (default ../data/sample-inbox)
# INBOX_DIR=/data/sample-inbox

# Optional: archive agent inputs/outputs to this S3 bucket (set on AWS)
S3_BUCKET=

# Order intake: time zone of the warehouses, used for the 08:00 pick-list cutoff when the request
# gives no received_at (and to read email header times as warehouse-local).
WAREHOUSE_TZ=America/Chicago

# Late same-day orders (Order desk step 6). The 08:00 pick list stays. From 08:00 until SAME_DAY_GRACE_UNTIL
# every same-day order is still added to today's pick list; until SAME_DAY_HARD_STOP only urgent orders are;
# from SAME_DAY_HARD_STOP every same-day order goes to tomorrow. HH:MM on the hour or half hour,
# 08:00 <= grace <= hard stop <= 14:00; the API refuses to start on a bad value.
SAME_DAY_GRACE_UNTIL=09:00
SAME_DAY_HARD_STOP=10:00

# /api/agents/*: requests per minute per client IP (in-memory, per process; 0 turns it off)
AGENT_RATE_LIMIT_PER_MIN=30

# Optional shared demo token. When set, POST /api/agents/* needs the header X-Demo-Token with this value.
# Leave empty to keep the agents open. Never commit a real value.
DEMO_TOKEN=

# Web app address, used for links in emails (e.g. the address confirmation link)
PUBLIC_SITE_URL=http://localhost:5173

# --- Email (app/email; see docs/09-email-service.md) ---
# How email leaves the app: sns (default; today's Weekly Brief), console (log only), memory (tests).
# brevo sends the formatted HTML email through Brevo's HTTP API (needs BREVO_API_KEY and a verified sender).
# smtp sends the formatted HTML email through an SMTP relay (Brevo: the SMTP_* settings below).
EMAIL_BACKEND=sns
# SNS: the Weekly Brief topic. Its confirmed subscribers receive the brief (plain text).
WEEKLY_BRIEF_TOPIC_ARN=

# Sender: must be an address verified and authenticated with the email provider (for Brevo: a verified
# sender, ideally on a domain with Brevo's SPF and DKIM records). Not used by SNS.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=DeliveryLens
EMAIL_REPLY_TO=

# Safe test mode (on by default): every email goes ONLY to EMAIL_TEST_RECIPIENTS, Cc and Bcc are dropped and
# the subject starts with [TEST]. Turn it off only where real recipients should get mail (production).
# Does not apply to SNS, whose topic always goes to its own confirmed subscribers.
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENTS=

# Weekly Brief recipients for backends that address recipients (comma separated). Set per environment
# (backend/.env for development, the test environment's settings, Secrets Manager for production).
WEEKLY_BRIEF_TO=
WEEKLY_BRIEF_CC=
WEEKLY_BRIEF_BCC=

# Brevo HTTP API key for EMAIL_BACKEND=brevo: only in AWS Secrets Manager, never in this file or git.
BREVO_API_KEY=

# SMTP for EMAIL_BACKEND=smtp (Brevo: smtp-relay.brevo.com, 587, starttls). Encrypted only: starttls (587) or
# ssl (465). The username and key go in backend/.env locally (gitignored) and AWS Secrets Manager in production,
# never in this file or git. Check them without sending: python -m app.email check
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Production reads the SMTP_* fields itself from this Secrets Manager secret (boto3, EC2 instance role); the
# deploy sets it. Leave unset locally: the SMTP_* values above are used instead.
# APP_SECRET_ID=deliverylens/app
# Per network operation; retries are for transient failures only, within about 40 seconds in total
SMTP_TIMEOUT_SECONDS=15
SMTP_MAX_RETRIES=2
