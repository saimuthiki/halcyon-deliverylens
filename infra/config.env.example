# Copy to infra/config.env and fill the <PLACEHOLDERS>.
# config.env is gitignored. Every script reads it.

PROJECT=deliverylens
AWS_REGION=<AWS_REGION>                    # us-east-1 recommended (widest Bedrock Claude access)
AWS_ACCOUNT_ID=<AWS_ACCOUNT_ID>            # 12 digits, see: aws sts get-caller-identity

# GitHub repo that may push images to ECR (OIDC, no stored keys)
GITHUB_REPO=Evoke-Hackathon-2026/InfinityStacks
# The same repo in GitHub's ID-based OIDC subject (owner@id/repo@id). GitHub now sends this form, so the
# deploy role trusts both. Find it as the Username of an AssumeRoleWithWebIdentity event in CloudTrail.
GITHUB_REPO_IDS=Evoke-Hackathon-2026@346869943/InfinityStacks@1435387832

# Amazon Bedrock model IDs (or inference-profile IDs) enabled in the region.
# Find them with: bash infra/scripts/00-check-access.sh
BEDROCK_MODEL_FAST=<BEDROCK_HAIKU_MODEL_ID>
BEDROCK_MODEL_SMART=<BEDROCK_SONNET_MODEL_ID>

# Network
VPC_ID=                                    # leave blank to use the default VPC
ALLOWED_SSH_CIDR=<YOUR_PUBLIC_IP>/32       # your office/home IP for SSH; never 0.0.0.0/0
KEY_PAIR_NAME=deliverylens-key             # created by 07-ec2.sh if missing

# Sizes (small on purpose: a 48k-row dataset)
EC2_INSTANCE_TYPE=t3.small                 # about $15/month; keeps the whole stack near $40/month (budget $100)
RDS_INSTANCE_CLASS=db.t4g.micro
RDS_STORAGE_GB=20

# Frontend origin allowed by the API (filled after Amplify is connected)
AMPLIFY_ORIGIN=https://main.<AMPLIFY_APP_ID>.amplifyapp.com

# Who gets the alarm emails (comma separated); each must click "Confirm subscription" in the AWS email
ALERT_EMAILS=you@example.com,teammate@example.com
# Who gets the weekly brief (comma separated); default ALERT_EMAILS
BRIEF_EMAILS=you@example.com
